<div class="flex column full">
    <!-- Vapen -->
    <div class="flex column heavy-border wrapper" style="width: 99%;">
        <b class="title" style="width: 85%; margin: auto;">{{localize "HEADER.WEAPONS"}}</b>
        <div class="weapons flex column margin" style="height: auto;">
            <div class="weapon grid center light-border w-100" style="grid-template-columns: 50px 1fr 1fr 1fr 1fr 0.6fr 130px;">
                <div></div>
                <b style="text-align: left; font-family: Berolina, serif; font-size: 1.4em;">vapen</b>
                <b style="text-align: center; font-family: Berolina, serif; font-size: 1.4em;">grepp</b>
                <b style="text-align: center; font-family: Berolina, serif; font-size: 1.4em;">bonus</b>
                <b style="text-align: center; font-family: Berolina, serif; font-size: 1.4em;">skada</b>
                <b style="text-align: left; font-family: Berolina, serif; font-size: 1.4em; display: block; padding-left: 10px; width: 100%;">färdighet</b>
                <a class="button item-create" title='{{localize "UI.ADD"}}' data-type="weapon"><i class="fas fa-plus"></i></a>
            </div>
            <div style="height: auto;">
                {{#each items as |item|}}
                    {{#if item.isWeapon}}
                        <div class="weapon weapon-row grid align-center w-100" style="grid-template-columns: 50px 1fr 1fr 1fr 1fr 0.6fr 130px;" data-item-id="{{item._id}}">
                            <div class="icon weapon-roll"><img class="icon" src="{{item.img}}" title="{{item.name}}" width="36" height="36" style="border: 1px solid white; border-radius: 3px;" onerror="this.style.display='none'"/></div>
                            <div class="name weapon-roll" style="text-align: left; cursor: pointer;"><b class="talent-name">{{item.name}}</b></div>
                            <div class="grip" style="text-align: center;">{{item.system.grip}}</div>
                            <div class="bonus" style="text-align: center;">{{item.system.bonus}}</div>
                            <div class="damage" style="text-align: center;">{{item.system.damage}}</div>
                            <div class="skill" style="text-align: left; padding-left: 10px; width: 100%;">{{localize (lookup (lookup ../actor.system.skill item.system.skill) "label")}}</div>
                            <div class="button" style="display: flex; justify-content: flex-end; align-items: center; gap: 4px; overflow: visible; width: 130px;">
                                <a class="item-control fav-togle" style="flex: 0 0 auto;" title='{{localize "UI.FAVORITE"}}'>
                                    {{#if item.system.isFav}}<i class="fas fa-star"></i>{{else}}<i class="far fa-star"></i>{{/if}}
                                </a>
                                <a class="item-control to-chat" style="flex: 0 0 auto;" title='{{localize UI.CHAT}}'><i class="fas fa-comment"></i></a>
                                <a class="item-control item-edit" style="flex: 0 0 auto;" title='{{localize "UI.EDIT"}}'><i class="fas fa-edit"></i></a>
                                <a class="item-control item-delete" style="flex: 0 0 auto;" title='{{localize "UI.DELETE"}}'><i class="fas fa-trash"></i></a>
                            </div>
                        </div>
                    {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
    <!-- Rustningar -->
    <div class="flex column heavy-border wrapper" style="width: 99%;">
        <b class="title" style="width: 85%; margin: auto;">{{localize "HEADER.ARMORS"}}</b>
        <div class="armors flex column margin" style="height: auto;">
            <div class="armor grid center light-border w-100" style="grid-template-columns: 50px 1fr 1fr 1fr 1fr 0.6fr 130px;">
                <div></div>
                <b style="text-align: left; font-family: Berolina, serif; font-size: 1.4em;">rustning</b>
                <b style="text-align: center; font-family: Berolina, serif; font-size: 1.4em;">skyddsvärde</b>
                <div></div>
                <div></div>
                <div></div>
                <a class="button item-create" title='{{localize "UI.ADD"}}' data-type="armor"><i class="fas fa-plus"></i></a>
            </div>
            <div style="height: auto;">
                {{#each items as |item|}}
                    {{#if item.isArmor}}
                        <div class="armor armor-row grid align-center w-100" style="grid-template-columns: 50px 1fr 1fr 1fr 1fr 0.6fr 130px;" data-item-id="{{item._id}}">
                            <div class="icon-box armor-roll"><img class="icon" src="{{item.img}}" title="{{item.name}}" width="36" height="36" style="border: 1px solid white; border-radius: 3px;" onerror="this.style.display='none'"/></div>
                            <div class="name armor-roll" style="text-align: left; cursor: pointer;"><b class="talent-name">{{item.name}}</b></div>
                            <div class="protection" style="text-align: center;">{{item.system.protection}}</div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div class="button" style="display: flex; justify-content: flex-end; align-items: center; gap: 4px; overflow: visible; width: 130px;">
                                <a class="item-control fav-togle" style="flex: 0 0 auto;" title='{{localize "UI.FAVORITE"}}'>
                                    {{#if item.system.isFav}}<i class="fas fa-star"></i>{{else}}<i class="far fa-star"></i>{{/if}}
                                </a>
                                <a class="item-control to-chat" style="flex: 0 0 auto;" title='{{localize UI.CHAT}}'><i class="fas fa-comment"></i></a>
                                <a class="item-control item-edit" style="flex: 0 0 auto;" title='{{localize "UI.EDIT"}}'><i class="fas fa-edit"></i></a>
                                <a class="item-control item-delete" style="flex: 0 0 auto;" title='{{localize "UI.DELETE"}}'><i class="fas fa-trash"></i></a>
                            </div>
                        </div>
                    {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
    <!-- Kritiska skador -->
    <div class="flex column heavy-border wrapper" style="width: 99%;">
        <b class="title" style="width: 85%; margin: auto;">{{localize "HEADER.CRITICAL_INJURIES"}}</b>
        <div class="critical-injuries flex column margin" style="height: auto;">
            <!-- SKADEFÄLT -->
            <div class="flex row align-center" style="padding: 6px 15px; margin-bottom: 8px; max-width: 250px; margin-left: auto; margin-right: auto; justify-content: space-between;">
                <b style="font-family: Berolina, serif; font-size: 1.6em; margin-right: 15px;">skador</b>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <input name="system.damageValue" type="text" value="{{system.damageValue}}" style="width: 45px; height: 30px; text-align: center; background: #f9f8f6; border: 1px solid #846758; box-shadow: none; font-size: 1.6em;" data-dtype="Number"/>
                    <span style="font-family: Berolina, serif; font-size: 1.6em;">/ {{system.attribute.strength.value}}</span>
                </div>
            </div>

            <div class="critical-injury grid center light-border w-100" style="grid-template-columns: 50px 1.2fr 1fr 1.5fr 1.2fr 0.8fr 100px;">
                <div></div>
                <b style="text-align: left; font-family: Berolina, serif; font-size: 1.3em;">skada</b>
                <b style="text-align: center; font-family: Berolina, serif; font-size: 1.3em;">läketid</b>
                <b style="text-align: center; font-family: Berolina, serif; font-size: 1.3em;">effekt</b>
                <b style="text-align: left; font-family: Berolina, serif; font-size: 1.3em; padding-left: 5px;">färdighet(er)</b>
                <b style="text-align: center; font-family: Berolina, serif; font-size: 1.3em;">dödlig</b>
                <a class="button item-create" title='{{localize "UI.ADD"}}' data-type="criticalInjury"><i class="fas fa-plus"></i></a>
            </div>
            <div style="height: auto;">
                {{#each items as |item|}}
                    {{#if (eq item.type "criticalInjury")}}
                        <div class="critical-injury critical-injury-row grid align-center w-100" style="grid-template-columns: 50px 1.2fr 1fr 1.5fr 1.2fr 0.8fr 100px;" data-item-id="{{item._id}}">
                            <div class="icon"><img class="icon" src="{{item.img}}" title="{{item.name}}" width="36" height="36" style="border: 1px solid white; border-radius: 3px;" onerror="this.style.display='none'"/></div>
                            <div class="name" style="text-align: left;"><b class="talent-name">{{item.name}}</b></div>
                            <div class="time-limit" style="text-align: center;">{{item.system.timeLimit}}</div>
                            <div class="effect" style="text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{item.system.effect}}">{{item.system.effect}}</div>
                            <div class="skill" style="text-align: left; padding-left: 5px; font-size: 0.9em;">
                                {{#if item.system.skill}}
                                    {{#each item.system.skill as |sKey|}}
                                        {{#if (ne sKey "none")}}
                                            {{localize (lookup (lookup ../../actor.system.skill sKey) "label")}}{{#unless @last}}, {{/unless}}
                                        {{/if}}
                                    {{/each}}
                                {{/if}}
                            </div>
                            <div class="fatal" style="text-align: center;">{{item.system.fatal}}</div>
                            <div class="button" style="display: flex; justify-content: flex-end; align-items: center; gap: 4px; overflow: visible; width: 100px;">
                                <a class="item-control to-chat" style="flex: 0 0 auto;" title='{{localize UI.CHAT}}'><i class="fas fa-comment"></i></a>
                                <a class="item-control item-edit" style="flex: 0 0 auto;" title='{{localize "UI.EDIT"}}'><i class="fas fa-edit"></i></a>
                                <a class="item-control item-delete" style="flex: 0 0 auto;" title='{{localize "UI.DELETE"}}'><i class="fas fa-trash"></i></a>
                            </div>
                        </div>
                    {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
</div>