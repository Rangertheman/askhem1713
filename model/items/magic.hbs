<form class="{{cssClass}} flexcol" autocomplete="off" style="padding: 10px;">
  <div class="bg-offwhite flex-row flex-start">
    <div class="dl-border w-fc h-100">
      <img class="w-100p border-none br-5" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    </div>

    <div class="w-100 padding-sm">
      <h1 class="center" style="margin: 0; padding: 5px;">
        <input name="name" type="text" value="{{item.name}}" style="height: 35px; font-size: 1.2em; background: #f9f8f6; border: 1px solid #846758; width: 100%; box-sizing: border-box; text-align: center;" />
      </h1>

      <div style="margin-top: 10px; width: 100%; box-sizing: border-box;">
        <b style="font-family: Berolina, serif; font-size: 1.0em; text-align: left;">beskrivning</b>
        <textarea name="system.description" style="background: #f9f8f6; border: 1px solid #846758; width: 100%; height: 120px; box-sizing: border-box; font-family: inherit; resize: none;">{{data.system.description}}</textarea>
      </div>

      <div class="grid grid-1col gap-sm" style="margin-top: 10px;">
        <div class="flex-col">
          <b style="font-family: Berolina, serif; font-size: 1.0em; text-align: left;">kostnad</b>
          <input class="light" name="system.cost" type="text" value="{{data.system.cost}}" style="background: #f9f8f6; border: 1px solid #846758; width: 100%; box-sizing: border-box;" />
        </div>
      </div>

      <input type="hidden" name="system.skill" value="discovery" />
    </div>
  </div>
</form>