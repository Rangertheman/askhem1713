<form class="{{cssClass}} flexcol" autocomplete="off" style="padding: 10px;">
  <div class="bg-offwhite flex-row flex-start">
    <div class="dl-border w-fc h-100">
      <img class="w-100p border-none br-5" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    </div>

    <div class="w-100 padding-sm">
      <h1 class="center" style="margin: 0; padding: 5px;">
        <input name="name" type="text" value="{{item.name}}" style="height: 35px; font-size: 1.2em; background: #f9f8f6; border: 1px solid #846758; width: 100%; box-sizing: border-box; text-align: center;" />
      </h1>

      <div class="grid grid-2col gap-sm" style="margin-top: 10px;">
        <div class="flex-col">
          <b style="font-family: Berolina, serif; font-size: 1.0em; text-align: left;">färdighet</b>
          <select name="system.skill" style="background: #f9f8f6; border: 1px solid #846758; width: 100%; box-sizing: border-box;">
             {{selectOptions config.bonusTypeDamageSkillsOptions selected=data.system.skill localize=true}}
          </select>
        </div>
        <div class="flex-col">
          <b style="font-family: Berolina, serif; font-size: 1.0em; text-align: left;">grepp</b>
          <select name="system.grip" style="background: #f9f8f6; border: 1px solid #846758; width: 100%; box-sizing: border-box;">
            <option value="-" {{#if (eq data.system.grip "-")}}selected{{/if}}>-</option>
            <option value="1H" {{#if (eq data.system.grip "1H")}}selected{{/if}}>1H</option>
            <option value="2H" {{#if (eq data.system.grip "2H")}}selected{{/if}}>2H</option>
          </select>
        </div>
        <div class="flex-col">
          <b style="font-family: Berolina, serif; font-size: 1.0em; text-align: left;">bonustärningar</b>
          <input class="light" name="system.bonus" type="text" value="{{data.system.bonus}}" style="background: #f9f8f6; border: 1px solid #846758; width: 100%; box-sizing: border-box;" />
        </div>
        <div class="flex-col">
          <b style="font-family: Berolina, serif; font-size: 1.0em; text-align: left;">skada</b>
          <input class="light" name="system.damage" type="text" value="{{data.system.damage}}" style="background: #f9f8f6; border: 1px solid #846758; width: 100%; box-sizing: border-box;" />
        </div>
      </div>
    </div>
  </div>
</form>